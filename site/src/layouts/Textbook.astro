---
/**
 * 3단 레이아웃 셸. 좌 단원 트리 / 중 본문 / 우 목차.
 * 모든 페이지가 이 레이아웃을 공유하므로 내비게이션 마크업이 페이지마다 복제되지 않는다.
 */
import '../styles/global.css';
import UnitTree from '../components/UnitTree.astro';
import { lessonsByArea, stats } from '../lib/content.js';
import { url } from '../lib/url.js';

const { title, currentId = null, showToc = true, toc = [] } = Astro.props;
---
<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title ? `${title} · 데이터 과학` : '데이터 과학 웹교과서'}</title>
  <meta name="description" content="2022 개정 교육과정 고등학교 「데이터 과학」 성취기준 기반 웹 교과서" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
  <script is:inline>
    // 테마를 첫 페인트 전에 적용해 깜빡임을 막는다
    try {
      const t = localStorage.getItem('ds-theme');
      if (t) document.documentElement.dataset.theme = t;
    } catch (e) {}
  </script>
</head>
<body>
  <a class="skip-link" href="#main">본문으로 건너뛰기</a>

  <header class="hdr">
    <button id="nav-toggle" class="hdr-btn" aria-expanded="false" aria-controls="unit-tree">☰ 단원</button>
    <a class="brand" href={url()}>데이터 과학<small>2022 개정 · 성취기준 기반 웹교과서</small></a>
    <span class="grow"></span>

    <form class="searchbox" role="search" action={url("search/")} method="get">
      <label class="sr-only" for="q">검색</label>
      <input id="q" name="q" type="search" placeholder="내용·성취기준 코드 검색" autocomplete="off" />
    </form>

    <a class="hdr-btn" href={url("crosswalk/")}>교과서 대조표</a>

    <button id="theme-toggle" class="hdr-btn" title="밝은/어두운 화면 전환" aria-label="화면 밝기 전환">◐</button>
  </header>

  <div class="progress-wrap" aria-hidden="true"><div class="progress-bar" id="progress-bar"></div></div>

  <div class="shell">
    <nav class="pane-tree" id="unit-tree" aria-label="단원 목차">
      <UnitTree groups={lessonsByArea} currentId={currentId} />
    </nav>

    <main class="pane-body" id="main">
      <slot />
    </main>

    {showToc && (
      <aside class="pane-toc" aria-label="이 페이지 목차">
        <slot name="aside" />
        {toc.length > 0 && (
          <>
            <p class="toc-h">이 차시의 내용</p>
            <ul class="toc-list" id="toc">
              {toc.map((t) => (
                <li><a href={`#${t.id}`} class={t.level === 3 ? 'lv3' : ''}>{t.text}</a></li>
              ))}
            </ul>
          </>
        )}
      </aside>
    )}
  </div>

  <footer class="tb-footer">
    <div class="fwrap">
      <span>데이터 과학 웹교과서 · 2022 개정 교육과정 (고등학교 진로 선택)</span>
      <span class="spacer"></span>
      <a href={url("standards/")}>성취기준</a>
      <a href={url("crosswalk/")}>교과서 대조표</a>
      <a href={url("about/")}>집필 근거</a>
    </div>
    <div class="flic">
      <div>제작 및 문의 : <a href="mailto:enssam21@gmail.com">enssam21@gmail.com</a></div>
      <div>이 웹페이지의 무단 배포 및 상업적 이용을 금합니다. 학교 수업 목적으로만 이용해 주세요.</div>
      <div><b>© 2026 티쳐무</b> · 모든 권리 보유</div>
    </div>
  </footer>

  <script is:inline define:vars={{ statsData: stats }}>
    window.__DS__ = { stats: statsData };
  </script>

  <script>
    import { initApp } from '../scripts/app.js';
    import { initQuizzes } from '../scripts/quiz.js';
    import { initTerms } from '../scripts/term.js';
    import { renderAllCharts } from '../scripts/chart.js';
    import { mountAllPyRunners } from '../scripts/pyrunner.js';
    import { initBlanks } from '../scripts/blanks.js';
    import { mountAllWidgets } from '../scripts/widget.js';

    initApp();
    initQuizzes();
    initTerms();
    initBlanks();
    try { mountAllWidgets(); } catch (e) { console.error('[widget] 초기화 실패', e); }
    // 차트·실행기 모듈은 실패해도 본문 읽기를 막지 않아야 한다
    try { renderAllCharts(); } catch (e) { console.error('[chart] 초기화 실패', e); }
    try { mountAllPyRunners(); } catch (e) { console.error('[pyrun] 초기화 실패', e); }
  </script>
</body>
</html>
